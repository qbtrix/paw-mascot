{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paw",
  "version": "0.1.0",
  "identifier": "com.qbtrix.paw-mascot",
  "build": {
    "frontendDist": "../../web",
    "devUrl": "http://localhost:8799"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Paw",
        "backgroundThrottling": "throttle",
        "url": "index.html",
        "width": 180,
        "height": 204,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "Paw"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
